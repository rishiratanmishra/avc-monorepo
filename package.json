{
  "name": "avc-app",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=api",
    "dev:admin": "turbo run dev --filter=admin",
    "dev:client": "turbo run dev --filter=web",
    "start:admin": "turbo run dev --filter=admin --filter=api",
    "start:client": "turbo run dev --filter=web --filter=api",
    "start:api": "turbo run dev --filter=api",
    "seed:admin": "yarn --cwd apps/api tsx ../../scripts/seed-admin.ts",
    "lint": "turbo run lint",
    "verify:eslint-coverage": "node scripts/verify-eslint-coverage.mjs",
    "lint:css": "stylelint \"apps/**/*.css\" \"packages/**/*.css\" && node scripts/check-css-tokens.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "ci": "yarn lint && yarn lint:css && yarn check-types && yarn test && yarn build"
  },
  "devDependencies": {
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "3.9.6",
    "stylelint": "^18.1.0",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "yarn",
      "version": "1.22.22"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
